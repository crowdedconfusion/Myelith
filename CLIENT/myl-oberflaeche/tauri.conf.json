{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myelith",
  "version": "0.1.0",
  "identifier": "org.myelith.oberflaeche",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Myelith",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Myelith, lokaler Betrieb",
    "longDescription": "Lokales Modell, lokaler Agent, Werkzeuge mit Einhaengegrenze."
  }
}
