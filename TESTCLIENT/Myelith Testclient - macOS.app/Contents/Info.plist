<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>              <string>Myelith Testclient</string>
    <key>CFBundleDisplayName</key>       <string>Myelith Testclient</string>
    <key>CFBundleIdentifier</key>        <string>org.myelith.testclient.starter</string>
    <key>CFBundleVersion</key>           <string>0.4.0</string>
    <key>CFBundleShortVersionString</key><string>0.4.0</string>
    <key>CFBundlePackageType</key>       <string>APPL</string>
    <key>CFBundleExecutable</key>        <string>starter</string>
    <key>CFBundleIconFile</key>          <string>myelith.icns</string>
    <key>LSMinimumSystemVersion</key>    <string>10.13</string>
    <!-- Kein eigenes Fenster: Das Buendel oeffnet Terminal.app und uebergibt
         den Starter. Der Client ist ein Terminalprogramm; ihm ein Fenster
         vorzublenden waere eine zweite Oberflaeche, die gepflegt werden muss. -->
    <key>LSBackgroundOnly</key>          <false/>
</dict>
</plist>
