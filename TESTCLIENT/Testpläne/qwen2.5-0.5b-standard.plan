# Myelith-Testplan
#
# Diese Datei legt fest, womit gemessen wird. Alle Beteiligten
# MÜSSEN sie unverändert verwenden: sonst weichen die Ergebnisse
# ab, und das sieht aus wie ein Befund, ist aber ein Tippfehler.
#
# Aufruf:  myl-test --plan qwen2.5-0.5b-standard.plan determinismus
#    oder:  myl-test  (Menü, Punkt 8)
#
# Die Zeile spec_sha256 sichert genau das ab. Kommentare und
# Reihenfolge gehen NICHT in die Prüfsumme ein, die Werte schon.

plan_id     = qwen2.5-0.5b-standard
prompt      = " The 2010 Haitian earthquake was a catastrophic magnitude 7.0 earthquake"
prompt      = "The capital of France is"
prompt      = "Die Hauptstadt von Frankreich ist"
prompt      = "In quantum mechanics, the wave function describes"
prompt      = "In der Quantenmechanik beschreibt die Wellenfunktion"
prompt      = "The result of 17 times 23 is"
steps       = 32
shards      = 4
model       = qwen2.5-0.5b

spec_sha256 = 12a1e91e4fa75f6e7a4171bca108ca11cd40ecb84b05889d9409b76e9fb0b859
