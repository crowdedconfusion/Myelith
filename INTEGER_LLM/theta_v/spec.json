{
  "theta_v": {
    "version": "0.4.0",
    "model": {
      "family": "qwen2.5",
      "variant": "0.5b-instruct",
      "source": "Qwen/Qwen2.5-0.5B-Instruct",
      "num_layers": 24,
      "hidden_size": 896,
      "intermediate_size": 4864,
      "num_heads": 14,
      "head_dim": 64,
      "vocab_size": 151936,
      "max_context": 2048
    },
    "numeric": {
      "formats": {
        "weight": { "dtype": "int8", "storage": "int8", "frac_bits": 7 },
        "activation": { "dtype": "int8", "storage": "int8", "frac_bits": 6 },
        "residual": { "dtype": "int16", "storage": "int16", "frac_bits": 8 },
        "accumulator": { "dtype": "int32", "storage": "int32" },
        "kv_cache": { "dtype": "int16", "storage": "int16", "frac_bits": 8 }
      },
      "scales": {
        "mode": "power_of_two",
        "weight_scale": "per_tensor",
        "activation_scale": "per_layer"
      },
      "rounding": "round_to_nearest_even",
      "shift_semantics": "arithmetic_right_shift",
      "overflow": "explicit_clamp_only"
    },
    "nonlinear": {
      "rsqrt": {
        "method": "lut",
        "input_range": [0, 32767],
        "input_shift": 7,
        "output_frac_bits": 8
      },
      "silu": {
        "method": "lut",
        "input_range": [-128, 127],
        "input_shift": 0,
        "output_frac_bits": 6
      },
      "softmax": {
        "method": "lut_exp",
        "exp_lut_range": 128,
        "exp_lut_frac_bits": 8,
        "prob_frac_bits": 8
      },
      "rope": {
        "method": "lut_sin_cos",
        "max_seq_len": 2048,
        "frac_bits": 8
      }
    },
    "sampling": {
      "prng": "splitmix64",
      "seed_source": ["segment_id", "block_hash"],
      "method": "integer_cdf",
      "tie_breaking": "lowest_index"
    },
    "pipeline": {
      "boundary_dtype": "int16",
      "boundary_frac_bits": 8,
      "endianness": "little",
      "shard_strategy": "layer_range",
      "stages": [
        {
          "stage_id": 0,
          "layer_start": 0,
          "layer_end": 6,
          "has_embedding": true,
          "has_lm_head": false,
          "has_sampling": false
        },
        {
          "stage_id": 1,
          "layer_start": 6,
          "layer_end": 12,
          "has_embedding": false,
          "has_lm_head": false,
          "has_sampling": false
        },
        {
          "stage_id": 2,
          "layer_start": 12,
          "layer_end": 18,
          "has_embedding": false,
          "has_lm_head": false,
          "has_sampling": false
        },
        {
          "stage_id": 3,
          "layer_start": 18,
          "layer_end": 24,
          "has_embedding": false,
          "has_lm_head": true,
          "has_sampling": true
        }
      ]
    }
  }
}