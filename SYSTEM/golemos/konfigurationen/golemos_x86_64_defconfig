# GolemOS, Stufe 1, x86_64.
#
# ⚑ Nur was begruendet ist. Jede Zeile hier kostet Platz im Abbild.

BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Der Kern. ⚑ Die Vorgabe der Architektur traegt die ueblichen Treiber
# fuer Platte und Netz; eine eigene Konfiguration kommt erst, wenn eine
# Zielmaschine bekannt ist.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
# ⛔️ **Nur x86_64 braucht das, und ohne bricht der Kernbau ab.**
#    `objtool` prueft die Aufrufketten und wird als Wirtswerkzeug
#    gebaut; es verlangt `gelf.h` aus libelf. 📌 Gemessen am 2026-09-24:
#    `compilation terminated` an genau dieser Zeile, nach 85 870 Zeilen
#    Bau. ⚑ **Buildroot baut sich libelf selbst**, statt dass der
#    Behaelter ein Paket mitbringen muss; damit haengt der Bau an einer
#    Zeile Konfiguration und nicht an der Ausstattung des Wirts.
#    ⚠️ Der aarch64-Kern kennt `objtool` nicht, deshalb fiel es dort
#    nicht auf.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y

# ⛔️ **Kein `BR2_LINUX_KERNEL_INSTALL_TARGET`.** 📌 Es legte den Kern ein
#    zweites Mal ins Dateisystem, 40 MB von 152. Beim Start ueber
#    Speicherdateisystem bekommt QEMU ihn getrennt; ein Bootloader
#    spaeter liest ihn von der Bootpartition. Im Wurzeldateisystem hat
#    er nichts zu suchen.

# ⚑ **Ein Speicherdateisystem fuer die Probe.** Kern und Abbild lassen
# sich damit ohne Bootloader in einer virtuellen Maschine starten, und
# genau das ist der erste Schritt: erst die Frage, die alles kippen
# kann, dann das Handwerk.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

# Netz, damit `curl` und die Web-Recherche etwas zu tun haben.
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_OPENSSL=y

BR2_TARGET_GENERIC_HOSTNAME="golemos"
BR2_TARGET_GENERIC_ISSUE="GolemOS"

# ⛔️ **Kein bash, kein less, und das ist eine Entscheidung.**
#    Buildroot versteckt beide hinter `BR2_PACKAGE_BUSYBOX_SHOW_OTHERS`,
#    weil BusyBox sie schon mitbringt. `bash` zoege ausserdem `readline`
#    und `ncurses` nach. ⚑ **BusyBox' `ash` ist eine POSIX-Shell und
#    genuegt**; `terminal_ausfuehren` im Fenster ruft `/bin/sh`, und
#    mehr verlangt niemand hier.
#    📌 Aufgefallen ist es, weil die Nachzaehlung in `bauen.sh` sie als
#    verschluckt gemeldet hat. Ohne sie waere ein Abbild entstanden, in
#    dem drei Dinge fehlen, die in der Konfiguration stehen.

# ⚑ Unsere Programme kommen als Ueberlagerung herein, nicht als Paket:
# Sie werden statisch gegen musl gebaut und haengen an nichts im System.
BR2_ROOTFS_OVERLAY="../overlay"

# ── Ein startfähiges Plattenabbild ──────────────────────────────────
#
# ⚑ **ext4 und nicht ext2.** Ohne Journal ist ein Stromausfall mitten im
#    Schreiben ein Dateisystem, das beim naechsten Start geprueft werden
#    muss; mit Journal ist er eine zurueckgenommene Schreibung.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# ⚠️ **Fest und nicht wachsend.** Zwei Wurzeln gleicher Groesse sind die
#    Voraussetzung dafuer, dass A und B austauschbar sind.
BR2_TARGET_ROOTFS_EXT2_SIZE="400M"

BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
# ⚑ Die Vorgabe plus `search` und `configfile`: ohne sie findet GRUB
#   seine eigene Konfiguration nicht, wenn sie neben ihm liegt.
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 part_msdos part_gpt normal efi_gop search configfile"

BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_ROOTFS_POST_BUILD_SCRIPT="/eingabe/abbild/nach-dem-bauen.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="/eingabe/abbild/nach-dem-abbild.sh"

# ── Die Datenpartition, die beim ersten Start waechst ───────────────
#
# ⛔️ **Ohne diese Pakete bleibt `golem-daten` bei 32 MB.** Nach `dd`
#    eines Abbilds auf einen Stick ist die Partition so gross wie im
#    Abbild, und ein Nutzer ohne Werkzeuge kann sie nicht dehnen.
#    ⚑ Der erste Start tut es selbst, wie es Wolkenabbilder und
#    Raspberry Pi OS seit jeher machen.
# ⚠️ Das `HOST_`-Gegenstueck weiter oben ist ein anderes Paket: Es baut
#    das Abbild auf dem Bauwirt, dieses laeuft auf dem Geraet.
# 📌 **`BR2_PACKAGE_UTIL_LINUX_FDISK` gibt es nicht**, den Namen hatte
#    ich erfunden, und die Nachzaehlung hat ihn gefangen. `fdisk` und
#    `sfdisk` kommen mit, sobald `libfdisk` an ist; eine
#    `--disable-fdisks`-Schraube kennt das Paket nicht.
# ⚠️ **BusyBox genuegt hier nicht:** Es hat `fdisk`, aber kein `sfdisk`,
#    und `CONFIG_FDISK_SUPPORT_LARGE_DISKS` steht auf aus.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_LIBFDISK=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y

# ⚑ Tastaturbelegungen und `loadkeys`, fuer die Wahl am Anfang des
#   Einrichtungsassistenten (Wunsch des Projektinhabers, 2026-09-25).
#   Ohne das Paket tippt jeder mit amerikanischer Belegung.
BR2_PACKAGE_KBD=y
