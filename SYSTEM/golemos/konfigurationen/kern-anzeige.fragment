# Ergaenzung der Kernkonfiguration (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES):
# die Anzeige, die die Oberflaechen-Schicht braucht.
#
# ⚑ **Fest eingebaut und nicht als Modul.** GolemOS hat kein udev und laedt
# Module nicht von selbst nach; ein Anzeigetreiber als Modul waere fuer die
# Schicht nicht da.
#
# ⚑ **`simpledrm` ist der Treiber fuer jede Maschine.** Er benutzt den
# Bildschirm, den die UEFI-Firmware schon eingerichtet hat, ohne zu wissen,
# welche Grafikkarte dahinter steckt. Unbeschleunigt, aber die Schicht
# zeichnet ohnehin in Software (pixman, softpipe). Damit startet die
# Oberflaeche auch auf Rechnern mit AMD- oder NVIDIA-Karte, fuer die der
# Kern der Basis keinen eigenen Treiber mitbringt.
#
# ⚑ `virtio-gpu` und `virtio-input` fuer virtuelle Maschinen (QEMU, UTM),
# auf denen die Schicht geprueft wird. Auf x86_64 bringt die Vorgabe beides
# schon mit, auf aarch64 nicht.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y

# ⛔️ **Und das Einhaengen der Schicht selbst: squashfs mit zlib, ueber ein
#    Loop-Geraet.** 📌 Gemessen am 2026-10-13: Die Vorgabe fuer aarch64
#    bringt squashfs mit, die fuer x86_64 nicht. Die Schicht fuer x86_64
#    waere geholt und geprueft worden und haette sich dann nicht einhaengen
#    lassen. Deshalb steht es hier und nicht in der Annahme ueber eine
#    Vorgabe.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y

# ⚑ **Die Module gepackt (GolemOS 0.6.1).** Die Vorgabe fuer aarch64 baut
#    Treiber fuer jedes ARM-Geraet, 84 MB in jeder Wurzel; als `.ko.xz`
#    bleibt jeder davon da. xz und nicht zstd, weil `kmod` und `depmod`
#    hier mit liblzma gebaut sind (siehe die Konfigurationen).
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_XZ=y
CONFIG_MODULE_COMPRESS_ALL=y

# ⚑ **exFAT fest eingebaut (GolemOS 0.6.1)**: der Datenteil des Sticks und
#    jedes fremde Laufwerk mit exFAT, wie es externe Platten ab Werk tragen.
#    Fest und nicht als Modul, weil `S05daten` vor `udevd` laeuft.
CONFIG_EXFAT_FS=y

# ⛔️ **Secure Boot traegt nur bis zum Kern, wenn der Kern dicht ist**
#    (GolemOS 0.7.0). Signiert sind shim, GRUB und der Kern; laedt der Kern
#    danach jedes Modul und laesst sich zur Laufzeit umschreiben, hat die
#    Kette nichts gekostet und nichts geschuetzt.
#    ⚑ Module nur mit Unterschrift: Der Bau erzeugt einen eigenen
#    Modulschluessel, signiert jedes Modul vor dem Packen und legt den
#    oeffentlichen Teil in den Kern; der private Teil bleibt im Baubaum.
#    ⚑ Lockdown „integrity" immer, auch ohne Secure Boot: kein
#    `/dev/mem`, kein Nachladen eines fremden Kerns, keine Ruhezustaende,
#    die ein veraendertes Abbild zurueckbraechten.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
